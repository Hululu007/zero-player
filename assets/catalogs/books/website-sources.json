      { "title": "推荐", "url": "/" },
      { "title": "玄幻奇幻", "url": "/c/xuanhuan" },
      { "title": "武侠仙侠", "url": "/c/xianxia" },
      { "title": "经典文学", "url": "/c/classicbook" },
      { "title": "情色工口", "url": "/c/herotic" },
      { "title": "耽美工口", "url": "/c/blerotic" },
      { "title": "成人排行", "url": "/c/hot" }
    ],
    "rules": {
      "list": ".novel-item",
      "title": ".novel-item-title@text",
      "book": ".novel-item-cover-wrapper a@href",
      "author": ".novel-item-author a@text",
      "cover": ".novel-item-thumbnail img@src",
      "latest": ".novel-item-newest-chapter a@text",
      "category": ".novel-item-category@text",
      "infoDescription": ".novel-detail .description@text",
      "infoCategory": ".novel-detail a[href*='/c/']@text",
      "chapters": "#chapter-list li a[href]",
      "chapterTitle": "@text",
      "chapterUrl": "@href",
