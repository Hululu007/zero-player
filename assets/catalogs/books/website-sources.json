[
  {
    "name": "繁體小說閱讀網",
    "group": "网络小说",
    "kind": "text",
    "format": "html",
    "url": "https://www.twxs.com.tw/",
    "discover": "/",
    "sample": "劍風傳奇",
    "defaultEnabled": false,
    "originNote": "按首页公开书目匹配标题和作者。站方转码失败的章节无法阅读或下载。",
    "mediaHosts": ["cdn.uameta.ai"],
    "discoveryCategories": [
      { "title": "推荐", "url": "/" },
      { "title": "排行", "url": "/rank.html" },
      { "title": "奇幻", "url": "/category/qihuan.html" },
      { "title": "武侠仙侠", "url": "/category/wuxia.html" },
      { "title": "成人小说", "url": "/category/rouwen.html" }
    ],
    "rules": {
      "catalogSearch": "true",
      "list": ".novel-list-item, .novel-grid-item",
      "title": ".item-name a@text || .info h3 a@text",
      "book": ".item-name a@href || .info h3 a@href",
      "author": ".item-author || .info p:eq(0)@text",
      "description": ".info p:eq(1)@text",
      "infoDescription": "[property='og:description']@content",
      "infoCategory": "[property='og:novel:category']@content",
      "infoLatest": "[property='og:novel:latest_chapter_name']@content",
      "nextDiscover": ".pagination a:contains(下一頁)@href",
      "chapters": ".chapter-grid a[data-cid]",
      "chapterTitle": "@text",
      "chapterUrl": "@href",
      "content": "#content@text"
    }
  },
  {
    "name": "愛下電子書",
    "group": "网络小说",
    "kind": "text",
    "format": "html",
    "url": "https://ixdzs8.com/",
    "search": "/bsearch?q={key}",
    "discover": "/new/",
    "sample": "万族之劫",
    "defaultEnabled": false,
    "mediaHosts": ["img22.ixdzs.com"],
    "originNote": "应用可检索新版书目。站方目录和正文触发浏览器验证，完整阅读链路尚未验收。",
    "rules": {
      "list": "li.burl, .ix-list li",
      "title": "h3 a[href^='/read/']@text",
      "author": "a[href^='/author/']@text",
      "book": "h3 a[href^='/read/']@href",
      "description": ".l-p2@text",
      "latest": ".l-chapter@text",
      "updated": ".l-time@text",
      "wordCount": ".size@text",
      "infoDescription": "[property='og:description']@content",
      "chapters": ".chapter li a[href$='.html']",
      "chapterTitle": "@text",
      "chapterUrl": "@href",
      "content": "#content@text || .page-content@text"
    }
  },
  {
    "name": "69书吧",
    "group": "网络小说",
    "kind": "text",
    "format": "html",
    "url": "https://www.69shuba.com/",
    "search": "/modules/article/search.php",
    "searchCharset": "gbk",
    "searchForm": { "searchkey": "{key}", "searchtype": "all", "action": "搜索" },
    "discover": "/",
    "sample": "霍格沃茨的学习面板",
    "defaultEnabled": false,
    "mediaHosts": ["cdn.cdnshu.com"],
    "originNote": "69shuba.cx 旧入口合并至本站。本机访问返回 HTTP 403，真实搜索和正文仍需在源站允许访问的网络复核。",
    "rules": {
      "list": ".newbox li, .bookbox, li",
      "title": ".bookname a@text || h3 a[href^='/book/'][href$='.htm']@text || a[href^='/book/'][href$='.htm']@text",
      "author": "label@text || .author@text",
      "book": ".bookname a@href || h3 a[href^='/book/'][href$='.htm']@href || a[href^='/book/'][href$='.htm']@href",
      "infoDescription": "[property='og:description']@content",
      "toc": "a[href^='/book/']:contains(完整目录)@href || a[href^='/book/']:contains(开始阅读)@href",
      "chapters": "#catalog li a[href], .catalog li a[href]",
      "chapterTitle": "@text",
      "chapterUrl": "@href",
      "content": ".txtnav@text || #content@text"
    }
  },
  {
    "name": "小說狂人",
    "group": "网络小说",
    "kind": "text",
    "format": "html",
    "url": "https://czbooks.net/",
    "search": "/s/{key}",
    "discover": "/",
